<?xml version="1.0" encoding="utf-8"?>
<!--
  The glyph of docs/icon.pdf, whose square fills the central 72dp of the 108dp layer, keeping
  the glyph inside the 66dp that no launcher mask cuts. Themed icons (Android 13) take only the
  monochrome layer's alpha, so the foreground serves as that too.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
